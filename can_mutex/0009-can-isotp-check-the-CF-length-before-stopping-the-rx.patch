From d6bed028af37e57186319aacac127ea7455f9c9c Mon Sep 17 00:00:00 2001
From: Oliver Hartkopp <socketcan@hartkopp.net>
Date: Thu, 19 Nov 2026 16:14:10 +0000
Subject: [PATCH 09/12] can: isotp: check the CF length before stopping the rx
 timeout

isotp_rcv_cf() stops the rx timeout with hrtimer_cancel() and then
drops consecutive frames with an invalid length:

- a CF that is longer than the first frame (cf->len > so->rx.ll_dl)
- a CF that is shorter than the first frame but is not the last CF

Both returns leave so->rx.state in ISOTP_WAIT_DATA without a running rx
timeout. Commit "can: isotp: always start the rx timeout in
ISOTP_WAIT_DATA state" added the rx timeout start for the regular
reception paths, but these two early returns are not covered.

Check the CF length first in isotp_rcv_cf(), so that an invalid CF is
dropped and the running rx timeout is left untouched. An invalid CF
also no longer updates the timestamp for CAN_ISOTP_FORCE_RXSTMIN. Every
return after hrtimer_cancel() now either ends the reception or restarts
the rx timeout.

Fixes: e057dd3fc20f ("can: add ISO 15765-2:2016 transport protocol")
Cc: stable@vger.kernel.org
Reported-by: Sashiko <sashiko-bot@kernel.org>
Closes: https://lore.kernel.org/linux-can/179504035916.3136.12986898667697830880@kernel.org/
Signed-off-by: Oliver Hartkopp <socketcan@hartkopp.net>
---
 net/can/isotp.c | 23 ++++++++++++-----------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/net/can/isotp.c b/net/can/isotp.c
index 32c88749d7..10eccaedeb 100644
--- a/net/can/isotp.c
+++ b/net/can/isotp.c
@@ -654,6 +654,17 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 	struct sk_buff *nskb;
 	int i;
 
+	/* CFs are never longer than the FF */
+	if (cf->len > so->rx.ll_dl)
+		return 1;
+
+	/* CFs have usually the LL_DL length */
+	if (cf->len < so->rx.ll_dl) {
+		/* this is only allowed for the last CF */
+		if (so->rx.len - so->rx.idx > so->rx.ll_dl - ae - N_PCI_SZ)
+			return 1;
+	}
+
 	if (READ_ONCE(so->rx.state) != ISOTP_WAIT_DATA)
 		return 0;
 
@@ -666,6 +677,7 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 		so->lastrxcf_tstamp = skb->tstamp;
 	}
 
+	/* stop the rx timeout only for valid CFs (checked above) */
 	hrtimer_cancel(&so->rxtimer);
 
 	/* isotp_rx_timer_handler() may have raced us for so->rx.state
@@ -674,17 +686,6 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 	if (READ_ONCE(so->rx.state) != ISOTP_WAIT_DATA)
 		return 1;
 
-	/* CFs are never longer than the FF */
-	if (cf->len > so->rx.ll_dl)
-		return 1;
-
-	/* CFs have usually the LL_DL length */
-	if (cf->len < so->rx.ll_dl) {
-		/* this is only allowed for the last CF */
-		if (so->rx.len - so->rx.idx > so->rx.ll_dl - ae - N_PCI_SZ)
-			return 1;
-	}
-
 	if ((cf->data[ae] & 0x0F) != so->rx.sn) {
 		/* wrong sn detected - report 'illegal byte sequence' */
 		sk->sk_err = EILSEQ;
