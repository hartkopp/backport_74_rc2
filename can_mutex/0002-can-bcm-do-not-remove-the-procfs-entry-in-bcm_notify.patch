X-Developer-Signature: v=1; a=ed25519-sha256; t=1794565649; l=5744;
 i=socketcan@hartkopp.net; s=20260128; h=from:subject:message-id;
 bh=5ZVj9zJbo3hpX3s/iiPgBkIURgOaGpGZNd2t5brt1xk=;
 b=lngYVDpL7ufWxmqR38lHUQrmnr9mRG0iPhx3ixzjcV9OhcJrD0uy0+62N1sSbOrzpYplLItuJ
 vpnhZUosKlmDi+htRYDpn0rq7Y+/bkVrukQ/R9HEFXHAGJp4dnLfsbK
